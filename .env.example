# Variáveis de ambiente das funções do site. NUNCA coloque os valores reais neste arquivo nem no repositório:
# elas são cadastradas no Netlify (Site configuration → Environment variables). Veja o README.md.

# Banco SQLite hospedado (Turso/libSQL). O token é a "senha" do banco.
EPIPER_BANCO_URL=libsql://NOME-DO-BANCO-SUA-CONTA.turso.io
EPIPER_BANCO_TOKEN=

# Chave que criptografa os dados pessoais dos contatos (32 bytes em base64).  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EPIPER_CHAVE_CAMPOS=

# Sal do hash de IP (qualquer texto longo e aleatório).  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EPIPER_SEGREDO_IP=

# Chave de acesso do Hub: gerada no Hub (menu SEO Site → Conexão) e colada aqui. Mínimo de 32 caracteres.
EPIPER_HUB_SEGREDO=

# Opcionais
# EPIPER_HUB_SEGREDO_ANTERIOR=   chave antiga, aceita durante a troca de chave (apague depois)
# EPIPER_HUB_IPS=                IPs do servidor do Hub separados por vírgula: só eles conseguem ler (recomendado)
# EPIPER_ORIGENS=                origens aceitas para coletar (padrão: https://epiper.com.br,https://www.epiper.com.br)
# EPIPER_RETENCAO_DIAS=          dias que a medição fica guardada (padrão 400)
